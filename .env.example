# Docker Compose supplies DATABASE_URL for the application container.
DATABASE_URL=postgresql+psycopg://groundedtrail:groundedtrail@localhost:5432/groundedtrail
# Backend: postgres (persistent, model backed) or memory (demo/test only).
GROUNDTRAIL_BACKEND=postgres
# Hash embeddings are intended only for an explicitly selected demo backend.
GROUNDTRAIL_EMBEDDINGS=local
# Optional: OPENAI_API_KEY and GROUNDTRAIL_LLM_MODEL enable generated answers.
GROUNDTRAIL_LLM_MODEL=gpt-4.1-mini
